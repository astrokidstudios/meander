{
  "name": "meander",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@supabase/supabase-js": "^2.49.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  },
  "description": "Meander: plan trips day by day, offline.",
  "author": "Josh",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.meander.planner",
    "productName": "Meander",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Meander-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Meander-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-1024.png",
      "category": "public.app-category.travel",
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "Meander uses your location to show where you are on the trip map.",
        "NSLocationUsageDescription": "Meander uses your location to show where you are on the trip map."
      }
    }
  }
}
